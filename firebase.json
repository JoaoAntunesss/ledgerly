{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "database.rules.json", "**/.*", "docs/**", "README.md", "LICENSE", "node_modules/**"],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(woff2|png)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  },
  "database": { "rules": "database.rules.json" }
}
